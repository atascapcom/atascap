---
import { LANGUAGES, buildLangSwitcher, pageHref } from '@data/translations';
import { SITE } from '@data/site';
import type { Lang, PageSlug } from '@data/translations';

interface Props {
  lang: Lang;
  pageKey: keyof PageSlug;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Transactional pages (subscribe confirmations, errors): keep them out of
   *  search results, and skip canonical/hreflang since they have no counterpart
   *  worth pointing at. */
  noindex?: boolean;
  /** Detail pages (a letter, a note): their own path. `pageKey` only names the
   *  section, so without this the canonical would point at the listing and tell
   *  search engines the piece is a duplicate of it. */
  canonicalPath?: string;
  /** Detail pages: hreflang alternates limited to the languages the piece was
   *  actually published in. Defaults to all three section pages. */
  alternates?: Array<{ lang: Lang; href: string }>;
  /** Per-piece share card, e.g. "/images/og/<slug>.png". Without it every
   *  shared link would show the same generic site card. */
  ogImage?: string;
  /** Set on a letter or a note. Switches og:type to "article" and emits
   *  Article structured data, which is what lets Search Console report the
   *  piece as content rather than as an anonymous page. */
  article?: {
    /** The piece's own title, without the " — Ataş Capital" suffix that the
     *  <title> carries. Google expects the bare headline here. */
    headline: string;
    publishedTime: Date;
    section: string;
  };
}

const {
  lang,
  pageKey,
  title,
  description,
  ogTitle,
  ogDescription,
  noindex = false,
  canonicalPath,
  alternates,
  ogImage,
  article,
} = Astro.props;

const t = LANGUAGES[lang];
const canonicalURL = new URL(canonicalPath ?? pageHref(lang, pageKey), SITE.domain).href;

const hreflangs = alternates ?? buildLangSwitcher(pageKey, lang);
// x-default points at the English version when there is one; otherwise the
// first available language, so a Turkish-only note still declares a default.
const defaultHref = (hreflangs.find((a) => a.lang === 'en') ?? hreflangs[0])?.href;
const ogImageURL = `${SITE.domain}${ogImage ?? '/og-image.png'}`;
const OG_LOCALE: Record<Lang, string> = { en: 'en_US', es: 'es_ES', tr: 'tr_TR' };

const organization = {
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.domain,
  email: SITE.email,
  founder: {
    '@type': 'Person',
    name: SITE.founderName,
    url: SITE.founderLinkedin,
  },
};

const jsonLd = JSON.stringify(
  article
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: article.headline,
        description,
        image: ogImageURL,
        datePublished: article.publishedTime.toISOString(),
        articleSection: article.section,
        inLanguage: t.htmlLang,
        mainEntityOfPage: canonicalURL,
        author: { '@type': 'Person', name: SITE.founderName, url: SITE.founderLinkedin },
        publisher: organization,
      }
    : { '@context': 'https://schema.org', ...organization }
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />

<!-- Google Search Console -->
<meta name="google-site-verification" content="XVs5Ze1VptKOFZvyK9de2xKKtrqOcBFtl68PlHRUcA8" />

<!-- Open Graph -->
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article && <meta property="article:section" content={article.section} />}
{article && <meta property="article:author" content={SITE.founderName} />}
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={OG_LOCALE[lang]} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle ?? title} />
<meta name="twitter:description" content={ogDescription ?? description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Canonical & hreflang -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <>
    <link rel="canonical" href={canonicalURL} />
    {hreflangs.map(({ lang: l, href }) => (
      <link rel="alternate" hreflang={l} href={`${SITE.domain}${href}`} />
    ))}
    {defaultHref && <link rel="alternate" hreflang="x-default" href={`${SITE.domain}${defaultHref}`} />}
  </>
)}

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- RSS — one feed per language, so a Turkish reader does not get English items -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — ${t.nav.letters}`}
  href={lang === 'en' ? '/rss.xml' : `/rss-${lang}.xml`}
/>

<!-- Stylesheet -->
<link rel="stylesheet" href="/style.css" />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={jsonLd} />

<!-- Self-hosted fonts (no third-party origin; see scripts/fetch-fonts.mjs) -->
<link rel="preload" href="/fonts/eb-garamond-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/fonts.css" />
