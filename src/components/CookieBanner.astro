---
/**
 * Cookie consent bar.
 *
 * Google Analytics sets cookies, so under GDPR/ePrivacy — and the AEPD's
 * reading of them — it may not run until the visitor actively agrees. This
 * component therefore never emits the Google tag: it injects it at runtime,
 * only after an explicit accept. Before that, nothing is requested from
 * Google at all, which is stricter (and easier to defend) than loading the tag
 * with consent-mode denied.
 *
 * "Decline" is presented exactly as prominently as "Accept"; a banner that
 * makes refusal harder is treated by the AEPD as no consent at all.
 *
 * With no `ga4Id` configured nothing is measured at all, so no bar is shown:
 * a cookie notice on a site that sets no cookies is just noise.
 */
import { ANALYTICS } from '@data/site';
import { LANGUAGES, pageHref } from '@data/translations';
import type { Lang } from '@data/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = LANGUAGES[lang].consent;
const needsConsent = ANALYTICS.ga4Id.length > 0;
const privacyHref = pageHref(lang, 'privacy');
---

{needsConsent && (
  <div class="consent" id="consentBar" role="dialog" aria-live="polite" aria-label={t.privacyLink} hidden>
    <p class="consent__text">
      {t.text}{' '}
      <a href={privacyHref}>{t.privacyLink}</a>
    </p>
    <div class="consent__actions">
      <button type="button" class="consent__btn" data-consent="denied">{t.reject}</button>
      <button type="button" class="consent__btn" data-consent="granted">{t.accept}</button>
    </div>
  </div>
)}

{needsConsent && (
  <script is:inline define:vars={{ ga4Id: ANALYTICS.ga4Id }}>
    (function () {
      var KEY = 'analytics-consent';
      var bar = document.getElementById('consentBar');
      if (!bar) return;

      function loadAnalytics() {
        if (window.__gaLoaded) return;
        window.__gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        // Ad features stay off: the banner only ever asked about measurement.
        gtag('config', ga4Id, { anonymize_ip: true, allow_google_signals: false });
      }

      var stored = null;
      try { stored = localStorage.getItem(KEY); } catch (e) {}

      if (stored === 'granted') loadAnalytics();
      else if (stored !== 'denied') bar.hidden = false;

      bar.addEventListener('click', function (event) {
        var choice = event.target && event.target.getAttribute('data-consent');
        if (!choice) return;
        try { localStorage.setItem(KEY, choice); } catch (e) {}
        if (choice === 'granted') loadAnalytics();
        bar.hidden = true;
      });

      // Consent must be as easy to withdraw as it was to give.
      document.addEventListener('click', function (event) {
        var el = event.target.closest && event.target.closest('[data-consent-manage]');
        if (!el) return;
        event.preventDefault();
        try { localStorage.removeItem(KEY); } catch (e) {}
        bar.hidden = false;
      });
    })();
  </script>
)}
