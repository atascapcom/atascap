---
import BaseLayout from '@layouts/BaseLayout.astro';
import { pageHref } from '@data/translations';
---

<BaseLayout
  lang="en"
  pageKey="home"
  title="Page Not Found — Ataş Capital"
  description="The page you are looking for could not be found."
>
  <section class="page-header">
    <h1>404</h1>
    <p>The page you seek has moved, or never existed.</p>
  </section>

  <section class="section">
    <div class="container--tight">
      <div class="content-block" style="text-align: center;">
        <p>Like the market, the web occasionally misprices a link. Let us return you to firmer ground.</p>
        <p style="margin-top: var(--space-xl);">
          <a href={pageHref('en', 'home')} style="font-family: var(--font-serif); font-size: var(--font-size-md); color: var(--color-accent); border-bottom: 1px solid var(--color-accent);">
            Return home →
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
