---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { noteSlug, noteAlternates, type NoteEntry } from '@data/notes';
import { detailHref } from '@data/content';
import { LANGUAGES, pageHref } from '@data/translations';
import type { Lang } from '@data/translations';
import SubscribeForm from '@components/SubscribeForm.astro';

export async function getStaticPaths() {
  const published = await getCollection('notes', ({ data }) => !data.draft);
  return published
    .filter((entry) => entry.data.lang === 'es')
    .map((entry) => ({
      params: { slug: noteSlug(entry) },
      // Each language keeps its own slug, so alternates carry full hrefs.
      props: { entry, alternates: noteAlternates(entry, published) },
    }));
}

const { entry, alternates } = Astro.props as {
  entry: NoteEntry;
  alternates: Array<{ lang: Lang; href: string }>;
};
const { Content } = await entry.render();

const t = LANGUAGES['es'];
const dateLabel = entry.data.date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  lang="es"
  pageKey="notes"
  title={`${entry.data.title} — Ataş Capital`}
  description={entry.data.description}
  canonicalPath={detailHref('notes', 'es', noteSlug(entry))}
  alternates={alternates}
>
  <article class="note">
    <div class="container--narrow">
      <header class="note__header">
        <p class="note__meta">{dateLabel}</p>
        <h1 class="note__title">{entry.data.title}</h1>
        <div class="divider divider--left"></div>
      </header>
      <div class="note__body">
        <Content />
      </div>
      <p class="note__back">
        <a href={pageHref('es', 'notes')}>{t.notes.backLink}</a>
      </p>
      <SubscribeForm lang="es" />
    </div>
  </article>
</BaseLayout>
