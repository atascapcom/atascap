---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { letterSlug, letterNumbers, periodLabel, letterNo, type LetterEntry } from '@data/letters';
import { detailHref, detailAlternates } from '@data/content';
import type { Lang } from '@data/translations';
import SubscribeForm from '@components/SubscribeForm.astro';

export async function getStaticPaths() {
  const published = await getCollection('letters', ({ data }) => !data.draft);
  const turkish = published.filter((entry) => entry.data.lang === 'tr');
  const numbers = letterNumbers(turkish);
  return turkish.map((entry) => {
    const slug = letterSlug(entry);
    const langs = (['en', 'tr', 'es'] as Lang[]).filter((lang) =>
      published.some((other) => other.data.lang === lang && letterSlug(other) === slug)
    );
    return { params: { slug }, props: { entry, no: numbers.get(entry.slug) ?? 1, langs } };
  });
}

const { entry, no, langs } = Astro.props as { entry: LetterEntry; no: number; langs: Lang[] };
const { Content } = await entry.render();

const slug = letterSlug(entry);
const dateLabel = entry.data.date.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long' });
const meta = [letterNo(no), periodLabel(entry.data.period, 'tr'), dateLabel].filter(Boolean).join(' · ');
---

<BaseLayout
  lang="tr"
  pageKey="letters"
  title={`${entry.data.title} — Ataş Capital`}
  description={entry.data.description}
  canonicalPath={detailHref('letters', 'tr', slug)}
  alternates={detailAlternates('letters', slug, langs)}
  article={{ headline: entry.data.title, publishedTime: entry.data.date, section: 'Mektuplar' }}
>
  <article class="letter">
    <div class="container--narrow">
      <div class="letter__letterhead" aria-hidden="true">ATAŞ CAPITAL</div>
      <header class="letter__header">
        <p class="letter__meta">{meta}</p>
        <div class="divider divider--left"></div>
      </header>
      <div class="letter__body">
        <Content />
      </div>
      <footer class="letter__sign">
        <p class="letter__sign-name">Aşkın Ataş</p>
      </footer>
      <div class="letter__downloads">
        {entry.data.pdf && <a class="letter__pdf" href={entry.data.pdf} download>↓ PDF Versiyonunu İndir</a>}
        <button class="letter__pdf" type="button" onclick="window.print()">Yazdırılabilir Versiyon</button>
      </div>
      <SubscribeForm lang="tr" />
    </div>
  </article>
</BaseLayout>
