# Copy to .env on the SERVER only — never commit the filled-in file.
# The repo is public; every value here is a secret or environment-specific.

# Resend API key (Resend dashboard → API Keys). Sending permission is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Resend audience that holds confirmed subscribers (Audiences → the list's ID).
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secret used to sign confirmation links. Generate once with:
#   openssl rand -base64 48
TOKEN_SECRET=change-me

# Verified sender in Resend. Use the sending subdomain so the root domain's
# ImprovMX SPF record stays untouched.
FROM_EMAIL=Ataş Capital <letters@news.atascap.com>

# Public site and this API's own origin (used to build confirmation links).
SITE_ORIGIN=https://atascap.com
PUBLIC_ORIGIN=https://api.atascap.com

PORT=3010
